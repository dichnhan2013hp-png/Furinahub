-- 2. Universal Closest Aimbot
local _G_Aimbot = false
AddOtherToggle("🎯 Universal Closest Aimbot", "Tự động hướng tâm nhìn vào mục tiêu gần nhất.", Color3.fromRGB(0, 180, 255), function(state)
    _G_Aimbot = state
    task.spawn(function()
        while _G_Aimbot do
            RunService.RenderStepped:Wait()
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local myPos = char.HumanoidRootPart.Position
                
                local closestTarget = nil
                local shortestDist = math.huge
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= char then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                        
                        if humanoid and rootPart and humanoid.Health > 0 then
                            local isPlayer = Players:GetPlayerFromCharacter(obj)
                            if isPlayer or obj.Parent == Workspace or obj.Parent.Name:lower().find(obj.Parent.Name, "enemy") then
                                local dist = (rootPart.Position - myPos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestTarget = rootPart
                                end
                            end
                        end
                    end
                end
                
                if closestTarget then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position + Vector3.new(0, 1.5, 0))
                end
            end)
        end
    end)
end)

