local function makeTag(adornee, withBar, kind)
	local bb = Instance.new("BillboardGui")
	bb.Name = "DW_Tag"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(170, withBar and 44 or 24)
	bb.StudsOffset = Vector3.new(0, withBar and 2.6 or 1.5, 0)
	bb.Adornee = adornee
	bb:SetAttribute("DWKind", kind)
	bb.Parent = adornee

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Info"
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.new(1, 0, withBar and 0.6 or 1, 0)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.TextStrokeTransparency = 0.3
	lbl.Parent = bb

	if withBar then
		local bg = Instance.new("Frame")
		bg.Name = "BarBG"
		bg.Size = UDim2.new(1, -10, 0, 6)
		bg.Position = UDim2.new(0, 5, 1, -8)
		bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		bg.BorderSizePixel = 0
		bg.Parent = bb
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.BackgroundColor3 = Color3.fromRGB(80, 230, 90)
		fill.BorderSizePixel = 0
		fill.Parent = bg
	end
	return bb
end

local function distToMe(pos)
	local _, hrp = char()
	return hrp and math.floor((hrp.Position - pos).Magnitude) or 0
end

local function clearKind(kind)
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d.Name == "DW_Tag" and d:GetAttribute("DWKind") == kind then
			d:Destroy()
		end
	end
end

local function clearPlayerESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			local cham = p.Character:FindFirstChild("DW_Cham")
			if cham then cham:Destroy() end
			local head = p.Character:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("DW_Tag")
			if tag then tag:Destroy() end
		end
	end
end

local function refreshPlayerESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local ch = p.Character
			local head = ch:FindFirstChild("Head")
			local hum = ch:FindFirstChildOfClass("Humanoid")
			local teamHidden = S.ESPTeam and p.Team ~= nil and p.Team == LP.Team
			if head and hum and S.ESPPlayers and not teamHidden and hum.Health > 0 then
				local cham = ch:FindFirstChild("DW_Cham")
				if S.ESPChams then
					if not cham then
						cham = Instance.new("Highlight")
						cham.Name = "DW_Cham"
						cham.FillTransparency = 0.6
						cham.OutlineColor = Color3.new(1, 1, 1)
						cham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						cham.Adornee = ch
						cham.Parent = ch
					end
					cham.FillColor = p.Team and p.Team.TeamColor.Color or Color3.fromRGB(255, 70, 70)
				elseif cham then
					cham:Destroy()
				end

				local tag = head:FindFirstChild("DW_Tag")
				if not tag then tag = makeTag(head, true, "player") end
				local info = tag:FindFirstChild("Info")
				if info then
					info.Text = string.format("%s | %dm", p.DisplayName, distToMe(head.Position))
				end
				local bar = tag:FindFirstChild("BarBG")
				local fill = bar and bar:FindFirstChild("Fill")
				if fill then
					fill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
				end
			end
		end
	end
end

local function refreshFruitESP()
	for _, o in ipairs(Workspace:GetChildren()) do
		if o:IsA("Tool") and o.Name:find("Fruit") then
			local h = o:FindFirstChild("Handle")
			if h and not h:FindFirstChild("DW_Tag") then
				local bb = makeTag(h, false, "fruit")
				bb.Info.TextColor3 = Color3.fromRGB(255, 210, 60)
			end
			if h and h:FindFirstChild("DW_Tag") then
				h.DW_Tag.Info.Text = string.format("%s [%dm]", o.Name, distToMe(h.Position))
			end
		end
	end
end

local lastChestScan = 0
local function refreshChestESP()
	if tick() - lastChestScan < 1.5 then return end
	lastChestScan = tick()
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d.Name:match("^Chest") and (d:IsA("Model") or d:IsA("BasePart")) then
			local part = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart")
			if part and not part:FindFirstChild("DW_Tag") then
				local bb = makeTag(part, false, "chest")
				bb.Info.TextColor3 = Color3.fromRGB(120, 220, 255)
				bb.Info.Text = d.Name
			end
		end
	end
end

