-- Cập nhật FPS Uncapped và Ping thời gian thực
local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount += 1
    local now = tick()
    if now - lastUpdate >= 0.5 then
        local fps = math.floor(frameCount / (now - lastUpdate))
        local ping = 0
        pcall(function()
            ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        end)
        InfoLabel.Text = string.format("FPS: %d+ | Ping: %dms", fps, ping)
        if fps >= 100 then
            InfoLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        elseif fps >= 45 then
            InfoLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
        else
            InfoLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        end
        frameCount = 0
        lastUpdate = now
    end
end)

