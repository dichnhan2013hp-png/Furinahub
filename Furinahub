local function findPlayerByName(name)
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then
			return p
		end
	end
	return nil
end

local function dumpTree(inst, depth, out)
	if depth > 3 then return end
	for _, c in ipairs(inst:GetChildren()) do
		table.insert(out, string.rep("  ", depth) .. c.Name .. " [" .. c.ClassName .. "]")
		dumpTree(c, depth + 1, out)
	end
end

local function runCommand(text)
	local args = {}
	for w in text:gmatch("%S+") do table.insert(args, w) end
	local cmd = (args[1] or ""):lower()
	local arg = args[2]
	local onOff = arg and (arg:lower() == "on" or arg:lower() == "1" or arg:lower() == "true")

	if cmd == "speed" and tonumber(arg) then
		S.SpeedVal = tonumber(arg)
		setFlag("Speed", true)
	elseif cmd == "jump" and tonumber(arg) then
		S.JumpVal = tonumber(arg)
		setFlag("Jump", true)
	elseif cmd == "fly" then
		setFlag("Fly", onOff)
	elseif cmd == "noclip" then
		setFlag("Noclip", onOff)
	elseif cmd == "infjump" then
		setFlag("InfJump", onOff)
	elseif cmd == "tp" and arg then
		local p = findPlayerByName(arg)
		if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			teleportTo(p.Character.HumanoidRootPart.CFrame)
		else
			notify("Command", "Không tìm thấy người chơi")
		end
	elseif cmd == "rejoin" then
		rejoin()
	elseif cmd == "hop" then
		serverHop()
	elseif cmd == "unload" then
		getgenv().DarkwenV1Unload()
	else
		notify("Command", "Lệnh không hợp lệ")
	end
end

