local function char()
	local ch = LP.Character
	if not ch then return nil end
	return ch, ch:FindFirstChild("HumanoidRootPart"), ch:FindFirstChildOfClass("Humanoid")
end

local function getLevel()
	local data = LP:FindFirstChild("Data")
	local lv = data and data:FindFirstChild("Level")
	return lv and lv.Value or 1
end

local function questForLevel(lv)
	for _, q in ipairs(SEA1_QUESTS) do
		if lv >= q.Min and lv <= q.Max then return q end
	end
	return nil
end

local function scanMobs()
	local list, seen = {"Any"}, {}
	local folder = Workspace:FindFirstChild("Enemies")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if not seen[m.Name] then
				seen[m.Name] = true
				table.insert(list, m.Name)
			end
		end
	end
	table.sort(list, function(a, b)
		if a == "Any" then return true end
		if b == "Any" then return false end
		return a < b
	end)
	return list
end

local function findMob(name, range)
	local folder = Workspace:FindFirstChild("Enemies")
	local _, myHRP = char()
	if not folder or not myHRP then return nil end
	local best, bestD = nil, math.huge
	for _, m in ipairs(folder:GetChildren()) do
		if name == "Any" or m.Name == name then
			local hum = m:FindFirstChildOfClass("Humanoid")
			local r = m:FindFirstChild("HumanoidRootPart")
			if hum and r and hum.Health > 0 then
				local d = (r.Position - myHRP.Position).Magnitude
				if (not range or d <= range) and d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

local function getTool(hum)
	local ch = LP.Character
	local t = ch and ch:FindFirstChildOfClass("Tool")
	if t then return t end
	local bp = LP:FindFirstChildOfClass("Backpack") and LP.Backpack:FindFirstChildOfClass("Tool")
	if bp and hum then pcall(function() hum:EquipTool(bp) end) end
	return nil
end

