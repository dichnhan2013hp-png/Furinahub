track(RunService.Heartbeat:Connect(function()
	local ch, hrp, hum = char()
	if not (ch and hrp and hum) or hum.Health <= 0 then return end

	if S.Speed then
		hum.WalkSpeed = S.SpeedVal
		Applied.Speed = true
	elseif Applied.Speed then
		hum.WalkSpeed = 16
		Applied.Speed = false
	end

	if S.Jump then
		hum.UseJumpPower = true
		hum.JumpPower = S.JumpVal
		Applied.Jump = true
	elseif Applied.Jump then
		hum.JumpPower = 50
		Applied.Jump = false
	end

	if S.Noclip then
		for _, part in ipairs(ch:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
		Applied.Noclip = true
	elseif Applied.Noclip then
		for _, part in ipairs(ch:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "Handle" then part.CanCollide = true end
		end
		Applied.Noclip = false
	end

	local bv = hrp:FindFirstChild("DW_Fly")
	if S.Fly then
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "DW_Fly"
			bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			bv.Parent = hrp
		end
		local look = Workspace.CurrentCamera.CFrame.LookVector
		local move = hum.MoveDirection
		local vert = 0
		if UIS:IsKeyDown(Enum.KeyCode.Space) then
			vert = 1
		elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			vert = -1
		end
		bv.Velocity = look * move.Magnitude * S.FlySpeed + Vector3.new(0, vert * S.FlySpeed, 0)
	elseif bv then
		bv:Destroy()
	end
end))

