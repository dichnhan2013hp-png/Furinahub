        page.CanvasSize = UDim2.new(0, 0, 0, pageList.AbsoluteContentSize.Y + 15)
    end)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.btn.BackgroundColor3 = Color3.fromRGB(22, 28, 45)
            t.btn.TextColor3 = Color3.fromRGB(170, 190, 215)
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    table.insert(tabs, {btn = tabBtn, page = page})
    if not activeTab then
        activeTab = tabBtn
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    return page
end

