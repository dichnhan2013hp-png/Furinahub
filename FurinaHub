local function httpGet(url)
	local req = request or http_request or (syn and syn.request)
	if not req then return nil end
	local ok, res = pcall(req, {Url = url, Method = "GET"})
	if ok and res and res.Body then return res.Body end
	return nil
end

local function serverHop()
	local body = httpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId))
	if not body then notify("Server Hop", "Executor không hỗ trợ request") return end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
	if not ok or not data or not data.data then notify("Server Hop", "Không đọc được danh sách server") return end
	local list = {}
	for _, s in ipairs(data.data) do
		if s.id ~= game.JobId and s.playing < s.maxPlayers then
			table.insert(list, s.id)
		end
	end
	if #list == 0 then notify("Server Hop", "Không có server trống") return end
	pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], LP)
	end)
end

local function jobIdHop(id)
	id = (id or ""):gsub("%s", "")
	if #id < 10 then notify("Job ID", "Job ID không hợp lệ") return end
	pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LP)
	end)
end

