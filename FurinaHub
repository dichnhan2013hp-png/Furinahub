getgenv().FurinaHubUnload = function()
	Running = false
	S.Farm, S.Fly, S.Noclip, S.Speed, S.Jump, S.Hitbox, S.Aura = false, false, false, false, false, false, false
	S.ESPPlayers, S.ESPFruit, S.ESPChest, S.Pickup, S.InfJump, S.Haki, S.Stats = false, false, false, false, false, false, false
	for _, c in ipairs(Conns) do
		pcall(function() c:Disconnect() end)
	end
	for _, l in pairs(Drawings) do
		pcall(function() l:Remove() end)
	end
	table.clear(Drawings)
	clearPlayerESP()
	clearKind("fruit")
	clearKind("chest")
	local ch, hrp, hum = char()
	if hum then
		hum.WalkSpeed = 16
		hum.JumpPower = 50
	end
	if ch then
		for _, part in ipairs(ch:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "Handle" then part.CanCollide = true end
		end
	end
	if hrp then
		local bv = hrp:FindFirstChild("DW_Fly")
		if bv then bv:Destroy() end
	end
	for r, sz in pairs(HitboxOrig) do
		if r.Parent then
			r.Size = sz
			r.Transparency = 1
		end
	end
	table.clear(HitboxOrig)
	if Popup then
		pcall(function() Popup:Destroy() end)
		Popup = nil
	end
	pcall(function() Gui:Destroy() end)
	getgenv().FurinaHubUnload = nil
end

