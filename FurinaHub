local function ensureQuest(q)
	if tick() - lastQuestTime < 12 then return end
	lastQuestTime = tick()
	local _, hrp = char()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = q.NPC + Vector3.new(0, 3, 0)
	end
	task.wait(0.6)
	pcall(function()
		CommF:InvokeServer("StartQuest", q.Quest, q.QLv)
	end)
	task.wait(0.6)
end

