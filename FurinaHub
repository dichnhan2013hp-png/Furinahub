local function findPlayerByName(name)
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then
			return p
		end
	end
	return nil
end

local function playerNames()
