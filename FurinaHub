		task.wait(0.15)
		if not S.Farm then continue end
		local ch, hrp, hum = char()
		if not (ch and hrp and hum) or hum.Health <= 0 then continue end

		local q, target = nil, S.MobName
		if S.FarmMode == "Level" then
